# Environment variables for Social Media Threat Intelligence Engine
# Copy this file to .env: `cp src/.env.example src/.env`
# NEVER commit .env to version control

# IBM watsonx.ai Credentials (Optional - built-in fallback active if omitted)
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_watsonx_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Application Settings
APP_PORT=8000
APP_HOST=0.0.0.0
APP_ENV=development

# Jurisdictional Settings
LEGAL_FRAMEWORK=BNS_2023  # Options: BNS_2023, IPC_LEGACY
TIMEZONE=Asia/Kolkata
