# Environment variables for Social Media Threat Intelligence Engine
# Copy this file to .env: `cp src/.env.example src/.env`
# NEVER commit .env to version control

# IBM Bob (headless `bob run` for threat classification)
# Required: `bob run` needs an API key even when you are signed in to Bob Shell.
# Create one at bob.ibm.com → your instance → API keys (Inference type recommended).
# Without it the app still runs, using cached Bob verdicts only.
BOB_API_KEY=
BOB_MAX_COST=0.25          # Bobcoin cap per classification call (measured ~0.025 per call)

# Application Settings
APP_PORT=8000
APP_HOST=127.0.0.1
APP_ENV=development
TIMEZONE=Asia/Kolkata

# Engine Settings
TIME_WINDOW_SECONDS=60     # coordination time window
MIN_EDGE_WEIGHT=2          # accounts must coordinate at least this many times

# Optional: pull posts straight from X (Datasets → Search X). Needs an X API plan that includes recent search.
# Create a bearer token at developer.x.com → your app → Keys and tokens.
X_BEARER_TOKEN=
