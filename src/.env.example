# Environment variables for Social Media Threat Intelligence Engine
# Copy this file to .env: `cp src/.env.example src/.env`
# NEVER commit .env to version control

# IBM Bob (headless `bob run` for threat classification)
# Optional if you are signed in to Bob Shell; required on machines without a signed-in session.
# Create an Inference API key at bob.ibm.com.
BOB_API_KEY=
BOB_MAX_COST=0.50          # Bobcoin cap per classification call

# Application Settings
APP_PORT=8000
APP_HOST=127.0.0.1
APP_ENV=development
TIMEZONE=Asia/Kolkata

# Engine Settings
TIME_WINDOW_SECONDS=60     # coordination time window
MIN_EDGE_WEIGHT=2          # accounts must coordinate at least this many times
